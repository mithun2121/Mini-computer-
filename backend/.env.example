# Generate a long random secret before enabling execution.
# PowerShell example: [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
EXECUTION_API_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_CODE_CHARS=20000
MAX_OUTPUT_CHARS=12000
RUN_TIMEOUT_SECONDS=5
RUNNER_IMAGE=mini-computer-runner:dev
