# Configure these as secrets/environment variables in Render. Never commit real values.
MINI_COMPUTER_PUBLIC_ORIGIN=https://YOUR-SERVICE.onrender.com
MINI_COMPUTER_OAUTH_SECRET=generate-a-random-secret-at-least-32-characters
MINI_COMPUTER_OAUTH_USERNAME=choose-a-private-login-name
MINI_COMPUTER_OAUTH_PASSWORD=choose-a-unique-long-password
MINI_COMPUTER_AGENT_TOKEN=generate-a-different-random-agent-secret
# Windows PC only: use absolute paths and restrict access to the directories you want available.
MINI_COMPUTER_CLOUD_AGENT_URL=wss://YOUR-SERVICE.onrender.com/agent
MINI_COMPUTER_ALLOWED_ROOTS=C:\\Users\\YOUR-WINDOWS-USER\\Mini-computer-\\workspace
